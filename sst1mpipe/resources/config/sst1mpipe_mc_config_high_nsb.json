{

    "analysis": {
      "global_theta_cut": 0.2,
      "global_gammaness_cut": 0.6,
      "gamma_efficiency": 0.6,
      "theta2_efficiency": 0.68,
      "stereo_delta_disp_cut_deg": null,
      "stereo_relative_std_reco_energy_cut": null,
      "stereo_std_gammaness_cut": null,
      "significance_fit": true,
      "log_energy_min_tev":-1,
      "log_energy_max_tev": 3,
      "n_energy_bins": 21,
      "n_bins_migration": 51,
      "fov_offset_max_deg": 6,
      "nbins_fov_offset": 9,
      "fov_offset_bg_max_deg": 8,
      "nbins_fov_offset_bg": 17,
      "source_offset_max_deg": 1,
      "nbins_source_offset": 501,
      "true_energy_scaling_factor": 1.0,
      "observation_time_h": 50,
      "off_regions": 5
    },

    "event_selection": {
        "hillas_intensity": [0, 1000000],
        "hillas_width": [0, 100],
        "hillas_length": [0, 100],
        "leakage_intensity_width_2": [0, 1]
    },

    "CameraCalibrator": {
        "image_extractor_type" : "LocalPeakWindowSum",
        "LocalPeakWindowSum": {
            "apply_integration_correction": true,
            "window_shift": 3,
            "window_width": 8
        },
        "invalid_pixel_handler_type": "NeighborAverage"
    },

    "ImageSaturationCorrector": {
      "integration_level": [
        ["type", "*", 0.2],
        ["id", 1, null],
        ["id", 2, null]
      ],
      "peak_time_level": [
        ["type", "*", 2500],
        ["id", 1, null],
        ["id", 2, null]
      ]
    },

    "R0R1Calibrator": {
      "calibrate_r0": [
        ["type", "*", true],
        ["id", 1, false],
        ["id", 2, false]
      ],
      "bad_pixels": [
        ["type", "*", []]
      ],
      "pde_drop_factor": [
        ["type", "*", null],
        ["id", 1, 0.9393873691700036],
        ["id", 2, 0.9819055121768047],
        ["id", 21, null],
        ["id", 22, null]
      ]
    },

    "NsbCalibrator": {
      "intensity_correction": {
        "tel_001": 1.0,
        "tel_002": 1.0
      }
    },

    "ImageProcessor": {
      "image_cleaner_type": "NSBImageCleaner",
      "use_telescope_frame": true,
      "TailcutsImageCleaner": {
          "picture_threshold_pe": [
            ["id", 1, 8],
            ["id", 2, 9]
          ],
          "boundary_threshold_pe": [
            ["id", 1, 4],
            ["id", 2, 4]
          ],
          "min_picture_neighbors": [
            ["id", 1, 2],
            ["id", 2, 2]
          ]
        },
        "NSBImageCleaner": {
            "picture_threshold_pe": [
              ["id", 1, 8],
              ["id", 2, 8]
            ],
            "boundary_threshold_pe": [
              ["id", 1, 4],
              ["id", 2, 4]
            ],
            "min_picture_neighbors": [
              ["id", 1, 2],
              ["id", 2, 2]
            ],
            "keep_isolated_pixels": false,
            "time_limit": 8,
            "time_num_neighbors": 1,
            "largest_island_only": false,
            "pedestal_factor": 2.5,
            "bright_cleaning_threshold": null
        }
    },

    "DataWriter": {
      "write_dl2": true
    },

    "ShowerProcessor": {
      "reconstructor_types": ["HillasReconstructor"],
      "HillasReconstructor": {
        "StereoQualityQuery":   {
          "quality_criteria": [
            ["enough intensity", "parameters.hillas.intensity > 0"],
            ["Positive width", "parameters.hillas.width.value > 0"],
            ["enough pixels", "parameters.morphology.n_pixels > 0"],
            ["not clipped", "parameters.leakage.intensity_width_2 < 1.0"]
          ]
        }
      }
    }

}
