{
    "SST1MEventSource": {
      "swapped_modules": [
        {"tel_id": 22, "start": "2023-09-01T00:00:00", "stop": "2024-07-18T00:00:00", "modules": [59, 88]},
        {"tel_id": 21, "start": "2025-12-17T12:00:00", "stop": "2026-01-15T12:00:00", "modules": [8, 9]}
      ]
    },

    "ImageSaturationCorrector": {
      "integration_level": 0.2,
      "peak_time_level": 2500
    },

    "R0R1Calibrator": {
      "calibration_file": [
        ["type", "*", null]
      ],
      "window_transmittance_file": [
        ["type", "*", null]
      ],
      "flag_bad_calibration_pixels": true,
      "saturation_threshold": 3000,
      "saturation_width_level": 2500,
      "saturation_width_threshold": 5,
      "bad_pixels": [
        ["type", "*", []]
      ],
      "pde_drop_factor": [
        ["type", "*", null],
        ["id", 21, null],
        ["id", 22, null]
      ]
    },

    "telescope_equivalent_focal_length": {
      "tel_021": 5.6,
      "tel_022": 5.6
    },

    "StereoTool": {
      "combiner_type": "WhiteRabbitClosestCombiner",
      "keep_mono": false,
      "copy_monitoring": true
    },

    "StereoEventCombiner": {
      "reference_tel_id": 21
    },

    "WhiteRabbitClosestCombiner": {
      "max_time_diff": "10 us"
    },

    "SlidingWindowCombiner": {
      "window_half_width": "1 ms",
      "time_offset": null,
      "offset_start": "-10 ms",
      "offset_stop": "10 ms",
      "offset_step": "20 us"
    },

    "analysis": {
      "global_theta_cut": 0.2,
      "global_gammaness_cut": 0.75,
      "stereo_delta_disp_cut_deg": null,
      "stereo_relative_std_reco_energy_cut": null,
      "stereo_std_gammaness_cut": null,
      "gamma_efficiency": 0.7,
      "log_energy_min_tev":-1,
      "log_energy_max_tev": 3,
      "n_energy_bins": 21,
      "reco_energy_scaling_factor": 1.0,
      "observation_time_h": 50,
      "off_regions": 5
    },

    "event_selection": {
        "hillas_intensity": [50, 1000000],
        "hillas_width": [0, 100],
        "hillas_length": [0, 100],
        "leakage_intensity_width_2": [0, 0.7]
    },

    "CameraCalibrator": {
        "image_extractor_type" : "LocalPeakWindowSum",
        "LocalPeakWindowSum": {
            "apply_integration_correction": true,
            "window_shift": 3,
            "window_width": 8
        },
        "invalid_pixel_handler_type": "NeighborAverage"
    },

    "NsbCalibrator": {
        "intensity_correction": {
          "tel_021": 1.0,
          "tel_022": 1.0
        }
    },

    "ImageProcessor": {
        "image_cleaner_type": "NSBImageCleaner",
        "use_telescope_frame": true,
        "TailcutsImageCleaner": {
            "picture_threshold_pe": [
              ["id", 21, 8],
              ["id", 22, 9]
            ],
            "boundary_threshold_pe": [
              ["id", 21, 4],
              ["id", 22, 4]
            ],
            "min_picture_neighbors": [
              ["id", 21, 2],
              ["id", 22, 2]
            ]
          },
        "NSBImageCleaner": {
            "picture_threshold_pe": [
              ["id", 21, 8],
              ["id", 22, 8]
            ],
            "boundary_threshold_pe": [
              ["id", 21, 4],
              ["id", 22, 4]
            ],
            "min_picture_neighbors": [
              ["id", 21, 2],
              ["id", 22, 2]
            ],
            "keep_isolated_pixels": false,
            "time_limit": 8,
            "time_num_neighbors": 1,
            "largest_island_only": false,
            "pedestal_factor": 2.5,
            "bright_cleaning_threshold": null
        }
    },

    "DataWriter": {
      "write_dl2": true
    },

    "ShowerProcessor": {
      "reconstructor_types": ["HillasReconstructor"],
      "HillasReconstructor": {
        "StereoQualityQuery":   {
          "quality_criteria": [
            ["enough intensity", "parameters.hillas.intensity > 0"],
            ["Positive width", "parameters.hillas.width.value > 0"],
            ["enough pixels", "parameters.morphology.n_pixels > 0"],
            ["not clipped", "parameters.leakage.intensity_width_2 < 1.0"]
          ]
        }
      }
    }

}

