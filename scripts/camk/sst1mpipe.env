# Paths and settings of the SST-1M pipeline on camk (scripts/camk), sourced by every script.
# Every variable can be set in the environment instead, e.g.
#   DATE=20260120 bash scripts/camk/submit_data.bash

# conda environment with sst1mpipe (empty: none is activated)
CONDA_ENV="${CONDA_ENV-sst1m-dev}"
CONFIG_DIRECTORY="${CONFIG_DIRECTORY:-${SST1MPIPE_ROOT}/sst1mpipe/resources/config}"
# jobs run in parallel in one job (stereo and DL2 of the data)
N_PARALLEL="${N_PARALLEL:-8}"

############################################
#  Simulations: R0 -> DL1 -> models, IRFs  #
############################################
# One NSB level: its simulated zenith angles (deg), and the simtel files of each particle and zenith
# angle (glob patterns, %zenith% replaced by each zenith angle)
# (default: the simulations of the Crab paper, NSBmed4)
MC_ZENITHS="${MC_ZENITHS:-20}"
MC_SIMTEL_DIRECTORY="${MC_SIMTEL_DIRECTORY:-/work/se3/jurysek/sst1m_crab_paper_mc}"
MC_GAMMA_DIFFUSE="${MC_GAMMA_DIFFUSE:-${MC_SIMTEL_DIRECTORY}/gammas_diffuse/zenith_%zenith%deg/gamma_*.simtel.gz}"
MC_GAMMA_POINT="${MC_GAMMA_POINT:-${MC_SIMTEL_DIRECTORY}/gammas_point/zenith_%zenith%deg/gamma_point_*.simtel.gz}"
MC_PROTON="${MC_PROTON:-${MC_SIMTEL_DIRECTORY}/protons_diffuse/zenith_%zenith%deg/proton_*.simtel.gz}"
# simtel files per task of the job arrays: each task counts as a job in the limit of jobs per user
# (2000 on camk: sacctmgr show assoc user=$USER format=maxsubmit; SLURM MaxArraySize: scontrol show config)
MC_FILES_PER_TASK="${MC_FILES_PER_TASK:-40}"
# outputs (MODELS_NAME: the zenith angles of the training, e.g. ze20_30):
# lists/, dl1/<particle>/ze<zenith>/, merged/ze<zenith>/ (training and test files of each zenith angle),
# merged/train_<MODELS_NAME>/ (training files of several zenith angles), models/<MODELS_NAME>/{mono,stereo}/,
# dl2/<MODELS_NAME>/ze<zenith>/, irf/<MODELS_NAME>/<IRF_CUTS>/<mode>/ze<zenith>/
MC_DIRECTORY="${MC_DIRECTORY:-/work/se2/${USER:-$(id -un)}/sst1mpipe/mc/crab_paper_NSBmed4}"
MC_CONFIG="${MC_CONFIG:-${CONFIG_DIRECTORY}/sst1mpipe_mc_config_low_nsb.json}"
# fraction of the diffuse gamma and proton files for the training, the others for the IRFs
MC_TRAIN_FRACTION="${MC_TRAIN_FRACTION:-0.5}"
# zenith angles of the training of the models (their training files merged by mc_merge_train.bash), and the
# name of the models, of their DL2 and IRFs: e.g. MC_ZENITHS="30" MC_TRAIN_ZENITHS="20 30" processes ze30
# and trains the models ze20_30 on ze20 and ze30, without overwriting the models ze20 and their outputs
MC_TRAIN_ZENITHS="${MC_TRAIN_ZENITHS:-${MC_ZENITHS}}"
MODELS_NAME="${MODELS_NAME:-ze$(echo ${MC_TRAIN_ZENITHS} | tr ' ' '_')}"
# more options of the training tools, e.g. "--n-events 700000"
TRAIN_OPTIONS="${TRAIN_OPTIONS:-}"
# CPUs of each task of the DL1 -> DL2 of the simulations (mc_dl1_dl2.bash), used by the random forests
# (sst1mpipe-apply-models --n-jobs), and memory per CPU
MC_DL2_CPUS="${MC_DL2_CPUS:-16}"
MC_DL2_MEM_PER_CPU="${MC_DL2_MEM_PER_CPU:-3G}"
# IRF cuts: optimized (best sensitivity) or paper (fixed cuts of arXiv:2506.01733: 60 % gammaness,
# 80 % theta); background: p_he (protons weighted to protons + helium) or protons
IRF_CUTS="${IRF_CUTS:-optimized}"
IRF_BACKGROUND="${IRF_BACKGROUND:-p_he}"
OPTIMIZE_CUTS_CONFIG="${OPTIMIZE_CUTS_CONFIG:-${CONFIG_DIRECTORY}/sst1mpipe_optimize_cuts.yaml}"
COMPUTE_IRF_CONFIG="${COMPUTE_IRF_CONFIG:-${CONFIG_DIRECTORY}/sst1mpipe_compute_irf.yaml}"

################################
#  Data of a night: R0 -> DL2  #
################################
DATE="${DATE:-$(date -d yesterday +%Y%m%d)}"
# raw files: ${RAW_DIRECTORY}/cs<tel>/data/raw/<YYYY>/<MM>/<DD>/(...)/SST1M<tel>_*.fits.fz
RAW_DIRECTORY="${RAW_DIRECTORY:-/work/se1/sst1m_data}"
# outputs: lists/, monitoring/cs<tel>/, dl1/{cs1,cs2,stereo}/, dl2/{cs1,cs2,stereo}/, dl3/{cs1,cs2,stereo}/
DATA_DIRECTORY="${DATA_DIRECTORY:-/work/se2/${USER:-$(id -un)}/sst1mpipe/data/${DATE}}"
DATA_CONFIG="${DATA_CONFIG:-${CONFIG_DIRECTORY}/sst1mpipe_data_config.json}"
MONITORING_CONFIG="${MONITORING_CONFIG:-${CONFIG_DIRECTORY}/sst1mpipe_monitoring_config.json}"
# models of the NSB level of the night: mono/ (cs1, cs2) and stereo/ (stereo) *.pkl
MODELS_DIRECTORY="${MODELS_DIRECTORY:-${MC_DIRECTORY}/models/${MODELS_NAME}}"
# IRFs of the DL3 (scripts/camk/mc_irf.bash: <mode>/ze<zenith>/, of the same models), and the IRF mode of
# each analysis
DATA_IRF_DIRECTORY="${DATA_IRF_DIRECTORY:-${MC_DIRECTORY}/irf/${MODELS_NAME}/${IRF_CUTS}}"
DATA_IRF_MODES="${DATA_IRF_MODES:-cs1=tel1 cs2=tel2 stereo=stereo}"
