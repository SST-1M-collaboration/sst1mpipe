# Settings of the daily analysis on camk (submit_data.bash): the paths of camk, the others of daily.env.
#   DATE=20260120 bash scripts/daily/submit_data.bash
CONDA_ENV="${CONDA_ENV-sst1m-dev}"
RAW_DIRECTORY="${RAW_DIRECTORY:-/work/se1/sst1m_data}"
DAILY_DIRECTORY="${DAILY_DIRECTORY:-/work/se2/${USER:-$(id -un)}/sst1mpipe/data}"
# simulations of scripts/camk (MC_DIRECTORY of scripts/camk/sst1mpipe.env)
MC_DIRECTORY="${MC_DIRECTORY:-/work/se2/${USER:-$(id -un)}/sst1mpipe/mc/crab_paper_NSBmed4}"
# files processed in parallel in a job: its CPUs
N_PARALLEL="${N_PARALLEL:-${SLURM_CPUS_PER_TASK:-8}}"
source "${SST1MPIPE_ROOT}/scripts/daily/daily.env"
