# Settings of the daily analysis (scripts/daily), defaults for Calculus (camk: camk.env).
# Every variable can be set in the environment instead, e.g.
#   DATE=20260120 bash scripts/daily/run_daily.bash

# conda environment with sst1mpipe (empty: none is activated); CONDA_ROOT: conda installation if not in
# the PATH or the home directory
CONDA_ENV="${CONDA_ENV-sst1m-dev}"
CONFIG_DIRECTORY="${CONFIG_DIRECTORY:-${SST1MPIPE_ROOT}/sst1mpipe/resources/config}"

# night (YYYYMMDD, date of the evening): yesterday by default
DATE="${DATE:-$(date -d yesterday +%Y%m%d)}"
# raw files: ${RAW_DIRECTORY}/cs<tel>/data/raw/<YYYY>/<MM>/<DD>/(...)/SST1M<tel>_*.fits.fz
RAW_DIRECTORY="${RAW_DIRECTORY:-/net}"
# outputs of the night: ${DAILY_DIRECTORY}/<DATE>/ with lists/, logs/, monitoring/cs<tel>/,
# dl1/{cs1,cs2,stereo}/, dl2/{cs1,cs2,stereo}/, dl3/{cs1,cs2,stereo}/
DAILY_DIRECTORY="${DAILY_DIRECTORY:-/data/work/analysis/Daily_analysis/daily_data}"
DATA_DIRECTORY="${DATA_DIRECTORY:-${DAILY_DIRECTORY}/${DATE}}"
DATA_CONFIG="${DATA_CONFIG:-${CONFIG_DIRECTORY}/sst1mpipe_data_config.yaml}"
MONITORING_CONFIG="${MONITORING_CONFIG:-${CONFIG_DIRECTORY}/sst1mpipe_monitoring_config.yaml}"

# models and IRFs of the simulations (scripts/camk/submit_mc.bash, copied from camk):
# ${MC_DIRECTORY}/models/<MODELS_NAME>/{mono,stereo}/*.pkl, ${MC_DIRECTORY}/irf/<MODELS_NAME>/<IRF_CUTS>/<mode>/ze<z>/
MC_DIRECTORY="${MC_DIRECTORY:-/data/work/analysis/MC/crab_paper_NSBmed4}"
MODELS_NAME="${MODELS_NAME:-ze20_30}"
IRF_CUTS="${IRF_CUTS:-optimized}"
MODELS_DIRECTORY="${MODELS_DIRECTORY:-${MC_DIRECTORY}/models/${MODELS_NAME}}"
DATA_IRF_DIRECTORY="${DATA_IRF_DIRECTORY:-${MC_DIRECTORY}/irf/${MODELS_NAME}/${IRF_CUTS}}"
# IRF mode of each analysis: cs1 -> tel1, cs2 -> tel2, stereo -> stereo
DATA_IRF_MODES="${DATA_IRF_MODES:-cs1=tel1 cs2=tel2 stereo=stereo}"

# files processed in parallel (R0 -> DL1, DL2, DL3): the cores of the machine (run_daily.bash), 8 in a
# SLURM job (submit_data.bash); threads of the random forests of each DL2 file (sst1mpipe-apply-models
# --n-jobs)
N_PARALLEL="${N_PARALLEL:-$(nproc)}"
DL2_N_JOBS="${DL2_N_JOBS:-1}"
